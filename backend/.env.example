# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database (MySQL) ----
# For local dev with docker-compose use the service name `mysql` as host.
DATABASE_URL="mysql://albarq:albarqpass@mysql:3306/callcenter"

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGIN=*

# ---- Demo / Asterisk ----
# DEMO_MODE=true forces the in-process mock Asterisk simulator (safe for public demo).
DEMO_MODE=true
# ASTERISK_MODE: mock | live
ASTERISK_MODE=mock

# ---- Live Asterisk (only used when ASTERISK_MODE=live) ----
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=admin
AMI_PASSWORD=
ARI_HOST=127.0.0.1
ARI_PORT=8088
ARI_USER=asterisk
ARI_PASSWORD=
