import { EventEmitter } from 'node:events';
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
import type {
  AsteriskAgentStatus,
  AsteriskConnectionStatus,
  AsteriskGateway,
  AsteriskLiveCall,
  OriginateParams,
} from './types.js';

const execFileAsync = promisify(execFile);

async function ast(args: string[]): Promise<string> {
  const { stdout } = await execFileAsync('asterisk', args, { timeout: 8000 });
  return stdout.toString();
}

function parseChannelsConcise(out: string): AsteriskLiveCall[] {
  return out
    .split('\n')
    .map((x) => x.trim())
    .filter(Boolean)
    .map((line) => {
      const p = line.split('!');
      const channel = p[0] || '';
      const context = p[1] || '';
      const exten = p[2] || '';
      const state = p[4] || '';
      const appData = p[7] || '';
      const callerNumber = p[8] || p[10] || 'Unknown';
      const uniqueId = p[11] || channel;
      const durationSec = Number(p[12] || 0) || 0;

      let status: AsteriskLiveCall['status'] = 'active';
      if (/Ring|Ringing/i.test(state)) status = 'ringing';
      if (/Down/i.test(state)) status = 'waiting';
      if (/Hangup/i.test(state)) status = 'ended';

      const agentMatch = appData.match(/PJSIP\/(\d+)/);
      const agentExtension = agentMatch?.[1];

      return {
        uniqueId,
        callerNumber,
        destinationNumber: exten || context || 'unknown',
        direction: 'inbound',
        status,
        agentExtension,
        queue: undefined,
        line: channel.includes('20001') ? 'TG400-20001' : undefined,
        startedAt: new Date(Date.now() - durationSec * 1000).toISOString(),
        durationSec,
      };
    });
}

function parseContacts(out: string): AsteriskAgentStatus[] {
  const result: AsteriskAgentStatus[] = [];
  for (const line of out.split('\n')) {
    const m = line.match(/Contact:\s+(\d+)\/sip:\1@/);
    if (!m) continue;
    const extension = m[1];
    result.push({
      extension,
      status: line.includes('Unavail') ? 'offline' : 'online',
      inCall: false,
    });
  }
  return result;
}

export class LiveAsteriskGateway extends EventEmitter implements AsteriskGateway {
  readonly mode = 'live' as const;
  private connected = false;
  private startedAt = Date.now();
  private timer?: NodeJS.Timeout;

  async connect(): Promise<void> {
    await ast(['-rx', 'core show uptime']);
    this.connected = true;

    this.timer = setInterval(async () => {
      try {
        const calls = await this.getLiveCalls();
        for (const c of calls) this.emit('call:update', c);

        const agents = await this.getAgentStatuses();
        for (const a of agents) this.emit('agent:update', a);
      } catch {
        this.connected = false;
      }
    }, 3000);
  }

  async disconnect(): Promise<void> {
    if (this.timer) clearInterval(this.timer);
    this.timer = undefined;
    this.connected = false;
  }

  async getConnectionStatus(): Promise<AsteriskConnectionStatus> {
    try {
      await ast(['-rx', 'core show uptime']);
      this.connected = true;
    } catch {
      this.connected = false;
    }

    return {
      mode: 'live',
      ami: this.connected ? 'connected' : 'disconnected',
      ari: 'disconnected',
      sip: this.connected ? 'registered' : 'unregistered',
      uptimeSec: Math.floor((Date.now() - this.startedAt) / 1000),
    };
  }

  async getLiveCalls(): Promise<AsteriskLiveCall[]> {
    const out = await ast(['-rx', 'core show channels concise']);
    return parseChannelsConcise(out);
  }

  async getAgentStatuses(): Promise<AsteriskAgentStatus[]> {
    const out = await ast(['-rx', 'pjsip show contacts']);
    return parseContacts(out);
  }

  async originate(_params: OriginateParams): Promise<{ uniqueId: string }> {
    throw new Error('Originate via CLI not implemented yet');
  }

  async answer(_uniqueId: string): Promise<void> {
    throw new Error('Answer not supported for already-routed live calls');
  }

  async hangup(uniqueId: string): Promise<void> {
    await ast(['-rx', `channel request hangup ${uniqueId}`]);
  }

  async hold(_uniqueId: string): Promise<void> {
    throw new Error('Hold not implemented yet');
  }

  async unhold(_uniqueId: string): Promise<void> {
    throw new Error('Unhold not implemented yet');
  }

  async transfer(_uniqueId: string, _target: string, _attended?: boolean): Promise<void> {
    throw new Error('Transfer not implemented yet');
  }

  async reloadConfig(): Promise<{ success: boolean; reloadedAt: string }> {
    await ast(['-rx', 'pjsip reload']);
    await ast(['-rx', 'dialplan reload']);
    return { success: true, reloadedAt: new Date().toISOString() };
  }
}
